{
  "name": "wechat",
  "display_name": "WeChat Channel",
  "kind": "channel",
  "version": "0.1.0",
  "wit_version": "0.3.0",
  "description": "Talk to your agent through a WeChat iLink bot",
  "keywords": [
    "messaging",
    "chat",
    "wechat",
    "weixin",
    "bot"
  ],
  "source": {
    "dir": "channels-src/wechat",
    "capabilities": "wechat.capabilities.json",
    "crate_name": "wechat-channel"
  },
  "artifacts": {
    "wasm32-wasip2": {
      "url": null,
      "sha256": null
    }
  },
  "auth_summary": {
    "method": "manual",
    "provider": "WeChat iLink",
    "secrets": [
      "wechat_bot_token"
    ],
    "shared_auth": null,
    "setup_url": "https://ilinkai.weixin.qq.com"
  },
  "tags": [
    "messaging"
  ]
}
